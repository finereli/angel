{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "angel",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"] }],
  "alias": {
    "@x402/svm/exact/client": "./src/worker/stubs/x402-svm.ts",
    "@x402/svm/exact/v1/client": "./src/worker/stubs/x402-svm.ts"
  },
  "observability": { "enabled": true },
  "routes": [{ "pattern": "angel.finereli.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws", "/mcp", "/oauth/*", "/.well-known/*", "/shop", "/respond/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "angel-db", "database_id": "1d914523-c7a9-4cd3-8b7b-811e56c3b01f", "migrations_dir": "migrations" }
  ],
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      { "name": "ANGEL_DO", "class_name": "AngelDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AngelDO"] }
  ]
}
