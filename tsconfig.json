{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["@cloudflare/workers-types", "vite/client", "svelte", "node"],
    "paths": { "$shared/*": ["./shared/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "shared/**/*.ts", "shared/**/*.svelte", "vite.config.ts"],
  "exclude": ["src/**/*.test.ts", "node_modules", "dist"]
}