{
  "name": "angel",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite dev\" \"wrangler dev\"",
    "dev:worker": "wrangler dev",
    "dev:client": "vite dev",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply angel-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply angel-db --remote"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "marked": "^18.0.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250525.0",
    "@sveltejs/vite-plugin-svelte": "^3.1.0",
    "@tailwindcss/typography": "^0.5.15",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "svelte": "^4.2.19",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vite": "^5.4.0",
    "wrangler": "^4.0.0"
  }
}
