{
  "name": "angel",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite dev\" \"wrangler dev\"",
    "dev:worker": "wrangler dev",
    "dev:client": "vite dev",
    "build": "npm run check && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "tsc --noEmit",
    "deploy": "./scripts/deploy.sh",
    "deploy:image": "./scripts/deploy.sh --with-image",
    "db:migrate:local": "wrangler d1 migrations apply angel-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply angel-db --remote",
    "test": "vitest run",
    "icon": "./scripts/icons.sh",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@cloudflare/sandbox": "^0.12.9",
    "dompurify": "^3.4.14",
    "hono": "^4.6.0",
    "marked": "^18.0.9",
    "node-html-markdown": "^2.0.0",
    "quickjs-emscripten": "^0.32.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250525.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "^24.0.0",
    "concurrently": "^9.1.0",
    "material-symbols": "^0.45.10",
    "svelte": "^5.39.5",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.0.0"
  }
}